# Django Core Settings
SECRET_KEY=django-insecure-healthcare-backend-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration (PostgreSQL)
# Option 1: Direct PostgreSQL connection (Port 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthcare_db

# Option 2: Via PgBouncer connection pooler (Port 6432)
# DATABASE_URL=postgres://postgres:postgres@localhost:6432/healthcare_db

# Individual DB fallback parameters
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
